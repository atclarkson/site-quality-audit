generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  accounts      Account[]
  auditRuns     AuditRun[]   @relation("AuditRequestedByUser")
  memberships   Membership[]
  sessions      Session[]
  ownedWorkspace Workspace?   @relation("PersonalWorkspaceOwner")

  @@map("users")
}

model Workspace {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  ownerUserId String?     @unique @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  auditRuns   AuditRun[]
  crawledPages CrawledPage[]
  ownerUser   User?       @relation("PersonalWorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships Membership[]
  sites       Site[]

  @@map("workspaces")
}

model Membership {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  workspaceId String         @db.Uuid
  role        MembershipRole
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("memberships")
}

model Site {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @db.Uuid
  name                 String
  primaryUrl           String
  normalizedPrimaryUrl String
  sitemapUrl           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  auditRuns            AuditRun[]
  crawledPages         CrawledPage[]
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, normalizedPrimaryUrl])
  @@index([workspaceId])
  @@map("sites")
}

model AuditRun {
  id                String         @id @default(uuid()) @db.Uuid
  workspaceId       String         @db.Uuid
  siteId            String         @db.Uuid
  requestedByUserId String?        @db.Uuid
  status            AuditRunStatus
  queueJobId        String?        @unique
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  discoveredUrlCount Int           @default(0)
  queuedUrlCount    Int            @default(0)
  crawledUrlCount   Int            @default(0)
  failedUrlCount    Int            @default(0)
  excludedUrlCount  Int            @default(0)
  progressUpdatedAt DateTime?
  robotsTxtUrl      String?
  robotsTxtStatusCode Int?
  robotsTxtFetchedAt DateTime?
  robotsTxtExists   Boolean?
  sitemapCount      Int            @default(0)
  sitemapUrlCount   Int            @default(0)
  sitemapWarningCount Int          @default(0)
  sitemapWarningMessage String?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  crawledPages      CrawledPage[]
  requestedByUser   User?          @relation("AuditRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  site              Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, siteId, createdAt])
  @@index([siteId, status])
  @@map("audit_runs")
}

model CrawledPage {
  id                    String                   @id @default(uuid()) @db.Uuid
  workspaceId           String                   @db.Uuid
  siteId                String                   @db.Uuid
  auditRunId            String                   @db.Uuid
  normalizedUrl         String
  requestedUrl          String
  finalUrl              String?
  statusCode            Int?
  contentType           String?
  responseTimeMs        Int?
  responseSizeBytes     Int?
  redirectCount         Int                      @default(0)
  title                 String?
  titleLength           Int?
  metaDescription       String?
  metaDescriptionLength Int?
  canonicalUrl          String?
  canonicalWarningCode  String?
  canonicalWarningMessage String?
  metaRobots            String?
  xRobotsTag            String?
  htmlLang              String?
  h1Count               Int                      @default(0)
  firstH1               String?
  h2Count               Int                      @default(0)
  visibleWordCount      Int                      @default(0)
  internalLinkCount     Int                      @default(0)
  externalLinkCount     Int                      @default(0)
  imageCount            Int                      @default(0)
  imagesMissingAltCount Int                      @default(0)
  structuredDataCount   Int                      @default(0)
  openGraphTitle        String?
  openGraphDescription  String?
  hasViewportMeta       Boolean                  @default(false)
  isIndexable           Boolean                  @default(true)
  crawlDepth            Int                      @default(0)
  discoverySource       CrawledPageDiscoverySource
  fetchStatus           CrawledPageFetchStatus
  errorCode             String?
  errorMessage          String?
  fetchedAt             DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  auditRun              AuditRun                 @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  site                  Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workspace             Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([auditRunId, normalizedUrl])
  @@index([workspaceId, auditRunId, normalizedUrl])
  @@index([workspaceId, siteId, auditRunId, fetchStatus])
  @@map("crawled_pages")
}

model Account {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum MembershipRole {
  OWNER
  EDITOR
  VIEWER
}

enum AuditRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum CrawledPageFetchStatus {
  SUCCESS
  NON_HTML
  FAILED
  EXCLUDED
}

enum CrawledPageDiscoverySource {
  PRIMARY
  SITEMAP
  LINK
}
